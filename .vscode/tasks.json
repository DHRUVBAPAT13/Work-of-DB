{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: Auto build active file (gcc/g++)",
      "command": "bash",
      "args": [
        "-c",
        "if [ \"${fileExtname}\" = \".cpp\" ] || [ \"${fileExtname}\" = \".cc\" ] || [ \"${fileExtname}\" = \".cxx\" ]; then /usr/bin/g++ -fdiagnostics-color=always -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" -lm; else /usr/bin/gcc -fdiagnostics-color=always -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" -lm; fi"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Automatically switches between g++ for C++ and gcc for C based on file extension"
    }
  ]
}