{
  "name": "Rocky Linux Multi-Language Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        // Low-level & Assembly
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "13xforever.language-x86-64-assembly",

        // Runtimes
        "golang.go",
        "vscjava.vscode-java-pack",
        "ms-python.python",
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        // Icons & UI
        "PKief.material-icon-theme"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "workbench.iconTheme": "material-icon-theme",
        // Vibrant terminal styling
        "workbench.colorCustomizations": {
          "terminal.background": "#10141d",
          "terminal.foreground": "#e2e8f0",
          "terminalCursor.foreground": "#38bdf8",
          "terminal.ansiGreen": "#4ade80",
          "terminal.ansiBrightGreen": "#86efac",
          "terminal.ansiCyan": "#38bdf8",
          "terminal.ansiBrightCyan": "#7dd3fc",
          "terminal.ansiYellow": "#facc15",
          "terminal.ansiMagenta": "#c084fc",
          "terminal.ansiRed": "#f87171",
          "terminal.ansiBlue": "#60a5fa"
        }
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [3000, 5000, 8080]
}